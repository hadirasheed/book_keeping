# Copy to .env.local and fill in from your Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The Google account that may access the admin panel (/admin).
ADMIN_EMAIL=you@gmail.com

# Auth is Google OAuth via Supabase Auth — enable the Google provider in your
# Supabase project (Authentication -> Providers -> Google) and add your site URL
# + <site>/auth/callback to the allowed redirect URLs. No app secret is needed
# here; Supabase holds the Google client id/secret.
